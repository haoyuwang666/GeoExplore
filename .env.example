# Copy this file to .env and replace the password before starting the app.
POSTGRES_DB=geoexplore
POSTGRES_USER=geoexplore_app
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/geoexplore
DB_USERNAME=geoexplore_app
DB_PASSWORD=replace_with_the_same_local_password

SERVER_PORT=8080
SESSION_TIMEOUT=12h
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_ATTEMPTS=10
RATE_LIMIT_COMMUNITY_WRITES=40

VITE_API_BASE_URL=/api
